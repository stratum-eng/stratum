{
  "name": "@stratum-eng/website",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Public documentation site for Stratum, built with Astro Starlight.",
  "type": "module",
  "scripts": {
    "sync:openapi": "node -e \"require('fs').copyFileSync('../docs/api/openapi.yml', 'public/openapi.yml')\"",
    "sync:guides": "node scripts/mirror-docs.mjs",
    "check:guides": "node scripts/mirror-docs.mjs --check",
    "sync:skills": "node scripts/emit-agent-skills.mjs",
    "sync:header": "node scripts/mirror-header.mjs",
    "check:header": "node scripts/mirror-header.mjs --check",
    "predev": "npm run sync:openapi && npm run sync:skills && npm run sync:header",
    "dev": "astro dev",
    "prebuild": "npm run sync:openapi && npm run sync:skills && npm run sync:header",
    "build": "astro build && node scripts/emit-markdown.mjs",
    "preview": "astro preview",
    "deploy": "npm run build && wrangler deploy",
    "brand": "node scripts/generate-brand-assets.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "@astrojs/starlight": "^0.36.0",
    "astro": "^5.6.0",
    "sharp": "^0.34.0",
    "starlight-llms-txt": "^0.7.0"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}

{
  "name": "@stratum-eng/ci-executor",
  "version": "0.1.0",
  "private": true,
  "description": "Stratum's first-party CI executor: a separate Worker that runs each job in a fresh Cloudflare Container",
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/stratum-eng/stratum.git",
    "directory": "ci-executor"
  },
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "image:build": "docker build --platform linux/amd64 -t stratum-ci-job container",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "lint": "biome check src tests",
    "lint:fix": "biome check --write src tests"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@cloudflare/workers-types": "^5.20261109.1",
    "@types/node": "^22.0.0",
    "typescript": "^5.8.3",
    "vitest": "^3.1.3",
    "wrangler": "4.159.0"
  },
  "engines": {
    "node": ">=22"
  }
}
